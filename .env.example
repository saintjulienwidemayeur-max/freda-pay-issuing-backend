# Copy this file to .env and fill in real values before running in production.
# Never commit the real .env file to version control.

PORT=4000

# Signs Freda Pay dashboard session tokens (signup.html login).
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# ---- Supabase (Postgres database) ----
# Run supabase-schema.sql once in your project's SQL Editor before starting the server.
# SERVICE_ROLE_KEY bypasses Row Level Security - it must NEVER be used in any
# frontend/browser file, only here, server-side.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- PlopPlop (the underlying MonCash/Natcash/carte provider) ----
# This is Freda Pay's OWN single merchant account with PlopPlop.
# All Freda Pay merchants' funds are pooled through this one account;
# Freda Pay's backend tracks each merchant's share internally (see src/services/ledger.js).
PLOPPLOP_BASE_URL=https://plopplop.solutionip.app
PLOPPLOP_CLIENT_ID=
PLOPPLOP_CLIENT_SECRET=

# PlopPlop enforces a 120s cooldown between withdrawals PER IP. Leave as-is
# unless PlopPlop tells you otherwise.
PAYOUT_COOLDOWN_MS=120000

# ---- Maplerad (card issuing: virtual Visa/Mastercard, business cards) ----
# This is Freda Pay's OWN single Maplerad account. Get your secret key from
# the Maplerad Dashboard > Settings > API Keys.
MAPLERAD_BASE_URL=https://api.maplerad.com/v1
MAPLERAD_SECRET_KEY=
# Signing secret for verifying incoming webhooks (Maplerad Dashboard > Webhooks).
# Looks like "whsec_...". Without this, card creation will stay stuck "pending"
# forever, since Maplerad confirms card creation asynchronously via webhook.
MAPLERAD_WEBHOOK_SECRET=
# Register this URL in the Maplerad Dashboard as your webhook endpoint:
#   https://YOUR-DEPLOYED-BACKEND/webhooks/maplerad

# ---- Brevo (transactional email: signup OTP, low-balance alerts) ----
# Get your API key from Brevo Dashboard > SMTP & API > API Keys.
BREVO_API_KEY=
# Must be a VERIFIED sender in Brevo (Dashboard > Senders & IP > Senders),
# otherwise every send is rejected.
BREVO_SENDER_EMAIL=otp.issuing@fredapay.com
BREVO_SENDER_NAME=Freda Pay Issuing

# ---- Self-ping keep-alive (prevents free-tier hosts like Render from sleeping) ----
# On Render, RENDER_EXTERNAL_URL is set automatically - you don't need to set
# anything here. Elsewhere, set SELF_PING_URL to this backend's own public URL.
SELF_PING_URL=

# Public site URL (no trailing slash) - used for absolute asset links like the
# logo image embedded in emails. Update once deployed to your real domain.
SITE_URL=https://issuing.fredapay.com
# Public address of THIS backend (serves the email/blog logo and the sitemap). The website is SITE_URL, the API is API_URL.
API_URL=https://api.fredapay.com
# Where the admin panel is hosted (optional: admin invitations also read it from the panel itself)
ADMIN_URL=

# ---- Master Wallet minimum reserve balance (USD) ----
# No merchant debit (card creation/funding, plan billing) may bring their
# Master Wallet below this floor. A low-balance email fires the first time a
# debit brings the balance down to it.
MASTER_WALLET_MINIMUM_USD=50


# ---- Maplerad LIVE (real cards, real money) ----
# Same API URL as sandbox: the key decides the environment. Never put a live key in MAPLERAD_SECRET_KEY.
MAPLERAD_LIVE_SECRET_KEY=mpr_sk_your_live_secret_key
MAPLERAD_LIVE_PUBLIC_KEY=mpr_pk_your_live_public_key
# Generated by Maplerad when you register https://api.fredapay.com/webhooks/maplerad in the LIVE dashboard
MAPLERAD_LIVE_WEBHOOK_SECRET=whsec_your_live_webhook_signing_secret

# Optional: static-IP proxy for calls to Maplerad (it only accepts a fixed, whitelisted IP). Leave empty to call directly.
MAPLERAD_PROXY_URL=
